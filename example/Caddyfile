http://localhost:9200 {
	route {
		encode zstd gzip
		minifier {
			html {
				KeepSpecialComments		true
				KeepComments			true
				KeepWhitespace			true
				KeepDefaultAttrVals		true
				KeepDocumentTags		true
				KeepEndTags				true
				KeepQuotes				true
			}
		}
		reverse_proxy localhost:3000
	}
}